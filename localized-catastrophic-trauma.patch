+// Hyper Adrenaline localized catastrophic trauma. Damage is final post-armor damage.
+#define HYPER_ADRENALINE_DISEMBOWEL_DAMAGE_THRESHOLD 55
+#define HYPER_ADRENALINE_DISEMBOWEL_BASE_CHANCE 15
+#define HYPER_ADRENALINE_CATASTROPHIC_TRAUMA_MAX_CHANCE 40
+
 //Damage and status effect defines
 
