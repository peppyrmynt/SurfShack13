+
+/// Hyper Adrenaline-only localized trauma. Existing full-body gib paths are deliberately untouched.
+/obj/item/bodypart/proc/try_catastrophic_trauma(wounding_type, wounding_dmg, attack_direction, damage_source)
+	if(!owner || CONFIG_GET(number/damage_multiplier) < HYPER_ADRENALINE_TRAUMA_MULTIPLIER)
+		return FALSE
+	if(owner.catastrophic_trauma_cooldown_until > world.time)
+		return FALSE
+	if(wounding_type == WOUND_BURN)
+		return FALSE
+
+	var/has_critical_wound = FALSE
+	for(var/datum/wound/iterated_wound as anything in wounds)
+		if(iterated_wound.severity >= WOUND_SEVERITY_CRITICAL)
+			has_critical_wound = TRUE
+			break
+	if(!has_critical_wound)
+		return FALSE
+
+	var/threshold
+	var/base_chance
+	switch(body_zone)
+		if(BODY_ZONE_HEAD)
+			threshold = CATASTROPHIC_HEAD_DAMAGE_THRESHOLD
+			base_chance = CATASTROPHIC_HEAD_BASE_CHANCE
+		if(BODY_ZONE_CHEST)
+			if(!(wounding_type in list(WOUND_SLASH, WOUND_PIERCE)))
+				return FALSE
+			threshold = CATASTROPHIC_DISEMBOWEL_DAMAGE_THRESHOLD
+			base_chance = CATASTROPHIC_DISEMBOWEL_BASE_CHANCE
+		else
+			if(!(body_zone in GLOB.limb_zones))
+				return FALSE
+			if(wounding_type == WOUND_SLASH)
+				threshold = CATASTROPHIC_SHARP_LIMB_THRESHOLD
+			else if(wounding_type == WOUND_BLUNT)
+				threshold = CATASTROPHIC_BLUNT_LIMB_THRESHOLD
+			else if(wounding_type == WOUND_PIERCE)
+				threshold = CATASTROPHIC_BALLISTIC_LIMB_THRESHOLD
+			else
+				return FALSE
+			base_chance = CATASTROPHIC_LIMB_BASE_CHANCE
+
+	if(wounding_dmg < threshold)
+		return FALSE
+	var/trauma_chance = min(base_chance + (wounding_dmg - threshold), CATASTROPHIC_TRAUMA_MAX_CHANCE)
+	if(!prob(trauma_chance))
+		return FALSE
+
+	owner.catastrophic_trauma_cooldown_until = world.time + CATASTROPHIC_TRAUMA_COOLDOWN
+	if(body_zone == BODY_ZONE_HEAD)
+		return owner.catastrophic_brain_ejection(src, attack_direction, damage_source)
+	if(body_zone == BODY_ZONE_CHEST)
+		return owner.catastrophic_disembowel(src, wounding_type, damage_source)
+	return dismember(BRUTE, silent = FALSE, wounding_type = wounding_type)
+
+/// Ejects the installed brain intact. Half the time the head is also removed; otherwise the normal debrained overlay leaves a blown-out cavity.
+/mob/living/carbon/proc/catastrophic_brain_ejection(obj/item/bodypart/head/head_part, attack_direction, damage_source)
+	if(!head_part || head_part.owner != src)
+		return FALSE
+	var/obj/item/organ/brain/brain = get_organ_slot(ORGAN_SLOT_BRAIN)
+	if(!brain)
+		return FALSE
+
+	var/turf/drop_turf = get_turf(src)
+	brain.Remove(src)
+	brain.forceMove(drop_turf)
+	var/throw_direction = attack_direction || dir
+	var/turf/throw_target = get_ranged_target_turf(src, throw_direction, 3)
+	var/datum/callback/gib_callback = CALLBACK(GLOBAL_PROC, GLOBAL_PROC_REF(spawn_atom_to_turf), /obj/effect/gibspawner/generic, brain, 1, FALSE, src)
+	brain.throw_at(throw_target, 3, 1, callback = gib_callback)
+
+	bleed(100)
+	for(var/i in 1 to 3)
+		add_splatter_floor(drop_turf)
+	playsound(drop_turf, 'sound/misc/splort.ogg', 90, TRUE)
+
+	if(prob(50) && head_part.can_dismember())
+		visible_message(span_bolddanger("[src]'s head bursts apart in a torrent of blood, ejecting [p_their()] brain!"))
+		head_part.dismember(BRUTE, silent = TRUE, wounding_type = WOUND_BLUNT)
+	else
+		visible_message(span_bolddanger("[src]'s brains erupt from a blasted cavity in [p_their()] skull!"))
+		update_body()
+	death()
+	return TRUE
+
+/// Reuses the existing chest dismember proc, which spills only currently installed chest-zone organs.
+/mob/living/carbon/proc/catastrophic_disembowel(obj/item/bodypart/chest/chest_part, wounding_type, damage_source)
+	if(!chest_part || chest_part.owner != src || !chest_part.contents.len)
+		return FALSE
+	visible_message(span_bolddanger("[src]'s torso is ripped open, spilling [p_their()] organs across the floor!"))
+	chest_part.dismember(BRUTE, silent = TRUE, wounding_type = wounding_type)
+	bleed(100)
+	log_combat(src, damage_source, "was catastrophically disemboweled by")
+	return TRUE
