@@ -861,6 +861,18 @@
 	var/atk_verb = pick(attacking_bodypart.unarmed_attack_verbs)
 	var/atk_effect = attacking_bodypart.unarmed_attack_effect
 
+	// HYPER ADRENALINE: shoe-wearing unarmed attackers can brutally execute critical or dead targets.
+	if(CONFIG_GET(number/damage_multiplier) >= 2 && user.shoes && !user.get_active_held_item() && target.stat >= SOFT_CRIT && prob(HYPER_TRAUMA_CURBSTOMP_CHANCE))
+		var/obj/item/bodypart/head/stomped_head = target.get_bodypart(BODY_ZONE_HEAD)
+		if(stomped_head && target.get_organ_slot(ORGAN_SLOT_BRAIN))
+			user.do_attack_animation(target, ATTACK_EFFECT_KICK)
+			playsound(target, 'sound/effects/dismember.ogg', 90, TRUE)
+			target.visible_message(span_bolddanger("[user] BRUTALLY CURBSTOMPS [target], bursting [target.p_their()] skull in an explosion of blood!"), span_userdanger("[user] brutally curbstomps you!"), span_hear("You hear a sickening, wet CRUNCH!"), COMBAT_MESSAGE_RANGE, user)
+			to_chat(user, span_bolddanger("You BRUTALLY CURBSTOMP [target]!"))
+			target.hyper_trauma_eject_brain(TRUE, user)
+			log_combat(user, target, "curbstomped")
+			return TRUE
+
 	if(atk_effect == ATTACK_EFFECT_BITE)
 		if(user.is_mouth_covered(ITEM_SLOT_MASK))
 			to_chat(user, span_warning("You can't [atk_verb] with your mouth covered!"))
