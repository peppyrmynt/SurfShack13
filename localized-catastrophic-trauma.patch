+#define CATASTROPHIC_HEAD_BASE_CHANCE 10
+#define CATASTROPHIC_DISEMBOWEL_DAMAGE_THRESHOLD 55
+#define CATASTROPHIC_DISEMBOWEL_BASE_CHANCE 15
+#define CATASTROPHIC_SHARP_LIMB_THRESHOLD 40
+#define CATASTROPHIC_BLUNT_LIMB_THRESHOLD 50
+#define CATASTROPHIC_BALLISTIC_LIMB_THRESHOLD 50
+#define CATASTROPHIC_LIMB_BASE_CHANCE 10
+#define CATASTROPHIC_CURBSTOMP_CHANCE 25
 
