+#define HYPER_ADRENALINE_EXPLOSION_MULTIPLIER 2
+#define HYPER_ADRENALINE_EMBED_CHANCE_MULTIPLIER 2
+#define HYPER_ADRENALINE_WOUND_MULTIPLIER 2
